{
  "name": "@velan/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src src/index.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('Data deleted. A fresh database is created on the next start.')\""
  },
  "dependencies": {
    "@velan/shared": "*",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  }
}
